ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
HEYGEN_API_KEY=your-heygen-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
DATABASE_URL=postgresql://...
GEMINI_API_KEY=...
ADMIN_TOKEN=...
# Optional: defaults to veo-3.1-fast-generate-preview. Try veo-3.1-lite-generate-preview to halve cost.
VEO_MODEL=veo-3.1-fast-generate-preview
PORT=3000

# Messaging (admin Send email / SMS / WhatsApp). All optional — leave blank to
# disable that channel; the admin button will surface the error inline.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=IE Demo <demo@yourdomain.com>
TWILIO_ACCOUNT_SID=AC...
# Auth via either (a) Account Auth Token, OR (b) API Key SID + Secret.
# API Key is preferred — individually revocable. Set one pair, not both.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
TWILIO_FROM_SMS=+14155551234
# Twilio Sandbox: +14155238886. With or without the "whatsapp:" prefix.
TWILIO_FROM_WHATSAPP=+14155238886
